# URL da API do back-end (exposta ao navegador; nunca coloque segredos aqui).
# Dev: http://localhost:8000. Produção/previews: a URL https do Coolify.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Chave pública do Cloudflare Turnstile, para o formulário de contato da landing.
# Vazia em dev: o back aceita o envio sem captcha quando ENVIRONMENT=local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# DSN do projeto do front no Sentry. Vazio = monitoramento desligado (padrão em dev).
# A DSN é pública por natureza: ela só permite enviar eventos.
NEXT_PUBLIC_SENTRY_DSN=
# Só para o build enviar os source maps ao Sentry. Este token é segredo: nunca use NEXT_PUBLIC.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
