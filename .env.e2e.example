# Variáveis dos testes E2E com Selenium. Ver e2e/README.md.
# Copie para .env.e2e (fica fora do git) e preencha. Uma variável definida no terminal vale mais que a deste arquivo.

# Onde a suíte roda: local (padrão) ou homologacao.
E2E_TARGET=local

# Front e API. No ambiente local, só endereços locais são aceitos.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000

# Navegador: chrome ou firefox. E2E_HEADLESS=false abre a janela.
E2E_BROWSER=chrome
E2E_HEADLESS=true
# Pausa antes de cada ação, em milissegundos.
E2E_DELAY_MS=1000

# --- Só no ambiente local ---
# O SETUP_TOKEN do .env do back, para criar o Administrador de teste no banco vazio.
E2E_SETUP_TOKEN=
# Pasta do repositório back, de onde os testes leem o log da API.
E2E_BACK_DIR=../back

# --- Administrador ---
# No ambiente local, pode ficar vazio: a suíte cria e usa um Administrador de teste.
# Na homologação, um Administrador que já existe.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Só na homologação: contas fixas, criadas uma vez à mão ---
# Os testes entram com elas no lugar dos usuários que convidam no ambiente local.
# Os dois Clientes têm os vínculos com condomínios apagados no começo de cada arquivo de teste.
E2E_OPERADOR_EMAIL=
E2E_OPERADOR_PASSWORD=
E2E_CLIENTE_EMAIL=
E2E_CLIENTE_PASSWORD=
E2E_CLIENTE2_EMAIL=
E2E_CLIENTE2_PASSWORD=
